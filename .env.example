# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database
DATABASE_URL=

# Web URL - Used for Flutterwave callback and other redirects
# Set to your actual deployment domain in production
WEB_URL=http://localhost:3002

# Flutterwave Configuration (legacy — existing active subscriptions only,
# no new purchases go through this anymore)
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=

# Paystack Configuration — all new subscription purchases
PAYSTACK_SECRET_KEY=

# Groq API - Used for AI-generated analytics reports (free tier available)
GROQ_API_KEY=

# Resend - Used for admin bulk email announcements (free tier: 100/day, 3000/month)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Roman Series <announcements@romanseries.com.ng>
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000

# Countdown Campaign - Set to true to enable countdown banner
NEXT_PUBLIC_COUNTDOWN_MODE=false
NEXT_PUBLIC_COUNTDOWN_END_DATE=2026-07-15T23:59:59Z

# Next.js Public Variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_FLW_PUBLIC_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3002
